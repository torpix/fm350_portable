#!/bin/sh

IFACE=${1:-}
ACTION=${2:-}
CONFIG=/etc/fm350-rndis.conf

[ -r "$CONFIG" ] || exit 0
# shellcheck disable=SC1090
. "$CONFIG"
FM_IF=${FM_IF:-auto}

[ "${CONNECTION_ID:-}" = "FM350_RNDIS" ] || exit 0

if [ "$FM_IF" = "auto" ]; then
    detected=$(fm350-detect 2>/dev/null || true)
    FM_IF=$(printf '%s\n' "$detected" | awk -F= '$1=="FM_IF"{print $2}')
fi

[ -n "$IFACE" ] && [ "$IFACE" = "$FM_IF" ] || exit 0

case "$ACTION" in
    up|vpn-up)
        /usr/local/sbin/fm350-connect >/dev/null 2>&1 &
        ;;
    down|vpn-down)
        /usr/local/sbin/fm350-disconnect >/dev/null 2>&1 &
        ;;
esac

exit 0

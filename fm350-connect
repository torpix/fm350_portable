#!/bin/sh
set -eu

CONFIG=/etc/fm350-rndis.conf
LOG=/tmp/fm350-rndis.log
LOCK=/run/fm350-rndis.lock
RESOLV=/etc/resolv.conf
RESOLV_BAK=/run/fm350-resolv.conf.bak

log() {
    printf '%s fm350-connect: %s\n' "$(date '+%F %T')" "$*" >> "$LOG"
}

die() {
    log "ERROR: $*"
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

load_config() {
    [ -r "$CONFIG" ] || die "Missing $CONFIG"
    # shellcheck disable=SC1090
    . "$CONFIG"
    APN=${APN:-internet}
    DNS1=${DNS1:-1.1.1.1}
    DNS2=${DNS2:-8.8.8.8}
    DNS3=${DNS3:-9.9.9.9}
    ROUTE_METRIC=${ROUTE_METRIC:-100}
    AT_PORT=${AT_PORT:-auto}
    FM_IF=${FM_IF:-auto}
}

detect_auto() {
    if [ "$AT_PORT" = "auto" ] || [ "$FM_IF" = "auto" ]; then
        detected=$(fm350-detect)
        det_at=$(printf '%s\n' "$detected" | awk -F= '$1=="AT_PORT"{print $2}')
        det_if=$(printf '%s\n' "$detected" | awk -F= '$1=="FM_IF"{print $2}')
        [ "$AT_PORT" != "auto" ] || AT_PORT=$det_at
        [ "$FM_IF" != "auto" ] || FM_IF=$det_if
    fi
}

at_cmd() {
    cmd=$1
    [ -c "$AT_PORT" ] || die "$AT_PORT is not a character device"
    tmp_in=$(mktemp)
    tmp_out=$(mktemp)
    {
        printf 'ATE0\r\n'
        printf '%s\r\n' "$cmd"
    } > "$tmp_in"
    log "AT >> $cmd"
    if timeout 10 atinout "$tmp_in" "$AT_PORT" "$tmp_out" 2>>"$LOG"; then
        out=$(sed '/^[[:space:]]*$/d; s/\r$//' "$tmp_out")
        log "AT << $out"
        printf '%s\n' "$out"
        rm -f "$tmp_in" "$tmp_out"
        return 0
    fi
    rm -f "$tmp_in" "$tmp_out"
    die "AT command timed out or failed: $cmd"
}

extract_ipv4() {
    awk '{
        while (match($0, /([0-9]{1,3}\.){3}[0-9]{1,3}/)) {
            ip=substr($0, RSTART, RLENGTH)
            n=split(ip, o, ".")
            if (n == 4 && o[1] <= 255 && o[2] <= 255 && o[3] <= 255 && o[4] <= 255) {
                print ip
                exit
            }
            $0=substr($0, RSTART + RLENGTH)
        }
    }'
}

do_connect() {
    load_config
    detect_auto
    [ "$AT_PORT" != "auto" ] || die "AT_PORT not detected"
    [ "$FM_IF" != "auto" ] || die "FM_IF not detected"
    [ -d "/sys/class/net/$FM_IF" ] || die "Network interface $FM_IF not found"
    [ -c "$AT_PORT" ] || die "$AT_PORT is not a character device"

    at_cmd "AT+CFUN?" >/dev/null || true
    at_cmd "AT+CEREG?" >/dev/null || true
    at_cmd "AT+CGDCONT=1,\"IP\",\"$APN\",\"\",0,0" >/dev/null
    at_cmd "AT+CGACT=1,1" >/dev/null

    ip_addr=""
    i=1
    while [ "$i" -le 12 ]; do
        resp=$(at_cmd "AT+CGPADDR=1" || true)
        ip_addr=$(printf '%s\n' "$resp" | extract_ipv4 | head -n 1)
        [ -n "$ip_addr" ] && break
        sleep 5
        i=$((i + 1))
    done
    [ -n "$ip_addr" ] || die "No IPv4 address from AT+CGPADDR=1"

    ip link set "$FM_IF" up
    ip addr flush dev "$FM_IF"
    ip addr add "$ip_addr/32" dev "$FM_IF"
    ip route replace default dev "$FM_IF" metric "$ROUTE_METRIC"

    ethtool -K "$FM_IF" gro off gso off tso off >>"$LOG" 2>&1 || true

    if [ -e "$RESOLV" ] && [ ! -e "$RESOLV_BAK" ]; then
        cp -a "$RESOLV" "$RESOLV_BAK" 2>>"$LOG" || true
    fi
    {
        printf 'nameserver %s\n' "$DNS1"
        printf 'nameserver %s\n' "$DNS2"
        printf 'nameserver %s\n' "$DNS3"
    } > "$RESOLV"

    log "UP done IF=$FM_IF IP=$ip_addr APN=$APN DNS=$DNS1,$DNS2,$DNS3 metric=$ROUTE_METRIC"
}

mkdir -p /run
(
    flock -n 9 || die "Another fm350-connect is running"
    do_connect
) 9>"$LOCK"

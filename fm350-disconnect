#!/bin/sh
set -eu

CONFIG=/etc/fm350-rndis.conf
LOG=/tmp/fm350-rndis.log
LOCK=/run/fm350-rndis.lock
RESOLV=/etc/resolv.conf
RESOLV_BAK=/run/fm350-resolv.conf.bak

log() {
    printf '%s fm350-disconnect: %s\n' "$(date '+%F %T')" "$*" >> "$LOG"
}

die() {
    log "ERROR: $*"
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

load_config() {
    if [ -r "$CONFIG" ]; then
        # shellcheck disable=SC1090
        . "$CONFIG"
    fi
    AT_PORT=${AT_PORT:-auto}
    FM_IF=${FM_IF:-auto}
    MANAGE_DNS=${MANAGE_DNS:-yes}
}

detect_auto() {
    if [ "$AT_PORT" = "auto" ] || [ "$FM_IF" = "auto" ]; then
        detected=$(fm350-detect)
        det_at=$(printf '%s\n' "$detected" | awk -F= '$1=="AT_PORT"{print $2}')
        det_if=$(printf '%s\n' "$detected" | awk -F= '$1=="FM_IF"{print $2}')
        [ "$AT_PORT" != "auto" ] || AT_PORT=$det_at
        [ "$FM_IF" != "auto" ] || FM_IF=$det_if
    fi
}

is_fm350_if() {
    iface=$1
    [ -d "/sys/class/net/$iface" ] || return 1

    mac=$(cat "/sys/class/net/$iface/address" 2>/dev/null || true)
    [ "$mac" = "00:00:11:12:13:14" ] && return 0

    dev=$(readlink -f "/sys/class/net/$iface/device" 2>/dev/null || true)
    while [ -n "$dev" ] && [ "$dev" != "/" ]; do
        if [ -r "$dev/idVendor" ] && [ -r "$dev/idProduct" ]; then
            vendor=$(cat "$dev/idVendor" 2>/dev/null || true)
            product=$(cat "$dev/idProduct" 2>/dev/null || true)
            if [ "$vendor" = "0e8d" ] && { [ "$product" = "7127" ] || [ "$product" = "7126" ]; }; then
                return 0
            fi
        fi
        dev=$(dirname "$dev")
    done

    return 1
}

detect_fm350_if_by_mac() {
    for path in /sys/class/net/*; do
        [ -e "$path/address" ] || continue
        iface=$(basename "$path")
        if is_fm350_if "$iface"; then
            printf '%s\n' "$iface"
            return 0
        fi
    done
    return 1
}

at_cmd_no_die() {
    cmd=$1
    [ -c "$AT_PORT" ] || {
        log "$AT_PORT is not a character device, skipping AT $cmd"
        return 1
    }
    tmp_in=$(mktemp)
    tmp_out=$(mktemp)
    {
        printf 'ATE0\r\n'
        printf '%s\r\n' "$cmd"
    } > "$tmp_in"
    log "AT >> $cmd"
    if timeout 10 atinout "$tmp_in" "$AT_PORT" "$tmp_out" 2>>"$LOG"; then
        out=$(sed '/^[[:space:]]*$/d; s/\r$//' "$tmp_out")
        log "AT << $out"
        printf '%s\n' "$out"
        rm -f "$tmp_in" "$tmp_out"
        return 0
    fi
    rm -f "$tmp_in" "$tmp_out"
    return 1
}

do_disconnect() {
    load_config
    detect_auto

    if { [ "$FM_IF" = "auto" ] || ! is_fm350_if "$FM_IF"; }; then
        detected_if=$(detect_fm350_if_by_mac || true)
        if [ -n "$detected_if" ]; then
            FM_IF=$detected_if
        fi
    fi

    if [ "$FM_IF" != "auto" ] && is_fm350_if "$FM_IF"; then
        ip route del default dev "$FM_IF" 2>>"$LOG" || true
        ip addr flush dev "$FM_IF" 2>>"$LOG" || true
        log "FM350 interface cleanup done IF=$FM_IF"
    else
        log "FM350 interface not available/validated, skipping Linux interface cleanup"
    fi

    if [ "$AT_PORT" != "auto" ]; then
        resp=$(at_cmd_no_die "AT+CGACT=0,1" || true)
        if printf '%s\n' "$resp" | grep -q '+CGEV: ME PDN DEACT 1'; then
            log "PDN deactivation event received"
        fi
    fi

    if [ "$MANAGE_DNS" = "yes" ]; then
        if [ -e "$RESOLV_BAK" ]; then
            cp -a "$RESOLV_BAK" "$RESOLV" 2>>"$LOG" || true
            rm -f "$RESOLV_BAK" 2>>"$LOG" || true
        fi
    else
        log "DNS_MANAGE_DISABLED"
    fi

    log "DOWN done"
}

mkdir -p /run
(
    flock -n 9 || die "Another fm350 operation is running"
    do_disconnect
) 9>"$LOCK"
